FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=blast_radius
# Set to 1 with the lite extra on Python 3.12+ to use an embedded FalkorDB.
FALKORDB_LITE=0
FALKORDB_LITE_PATH=.data/falkordb.db
# Optional: enables OpenAI tool-based incident extraction. Rules and approval remain deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AGENTS=0
